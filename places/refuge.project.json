      "StarterPlayerScripts": {
        "Client": {
          "$path": "../src/client/Core",
          "Place": {
            "$path": "../src/client/Refuge"
          }
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      },
      "Greybox": {
        "$path": "../maps/refuge/Greybox.model.json"
      }
    }
  }
