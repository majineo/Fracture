{
  "name": "Fracture-Refuge",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "../src/shared",
        "PlaceKind": {
          "$path": "../src/places/refuge/PlaceKind.luau"
        }
      }
    },
    "ServerScriptService": {
